# Customer Support System Environment Configuration Example
# Copy this file to .env or configure in application.properties / system environment variables

# Server Configuration
SERVER_PORT=8080
API_BASE_PATH=/api

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/customer_support_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:8080
